@startuml usecase-diagram
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Beets User" as User

rectangle "Beets System (titlecase plugin)" {
  usecase "UC-01\nTitlecase tracks\nmatching a query" as UC01
  usecase "UC-02\nPreview proposed\nchanges (-p)" as UC02
  usecase "UC-03\nTitlecase album\nrecords (-a)" as UC03
  usecase "UC-04\nPreview album\nchanges (-p with -a)" as UC04
  usecase "UC-05\nSelect tracks or\nalbums by query" as UC05
}

User --> UC01
User --> UC02
User --> UC03
User --> UC04

UC02 .> UC01 : <<extend>>
UC03 .> UC01 : <<extend>>
UC04 .> UC03 : <<extend>>
UC01 .> UC05 : <<include>>
UC03 .> UC05 : <<include>>
@enduml