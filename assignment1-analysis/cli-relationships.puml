@startuml
allowmixing
set namespaceSeparator none
title CLI, Utilities, and Supporting Components
hide empty members
top to bottom direction
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 12

package "CLI: beets.ui" {
  component "beets.ui\nmain() / _raw_main()\n_setup()" as CLI <<module>>
  class SubcommandsOptionParser {
    parse_global_options()
    parse_subcommand()
  }
  class CommonOptionsParser
  class Subcommand {
    name : str
    func : Callable
    parse_args()
  }
}

package "Built-in commands" {
  component "beets.ui.commands\ndefault_commands\nimport / list / modify / config" as Commands <<module>>
  component "import_files()" as ImportFiles <<function>>
  class "TerminalImportSession" as TerminalSession
}

package "Shared support" {
  ' beets/__init__.py: IncludeLazyConfig and the global config instance.
  class "beets.IncludeLazyConfig" as Config {
    read()
    log_sources()
  }
  component "beets.util\nnormpath() / syspath()\ndisplayable_path()" as Util <<module>>
  component "beets.logging\ngetLogger()" as Logging <<module>>
}

class "Library\nbeets.library" as Library <<reference>>
class "ImportSession\nbeets.importer" as ImportSession <<reference>> {
  run()
}
component "beets.plugins\nload_plugins()\ncommands() / send()" as Plugins <<module>>

' beets/ui/__init__.py: parser inheritance and stored command/parser references.
SubcommandsOptionParser --|> CommonOptionsParser
SubcommandsOptionParser --> "0..*" Subcommand : subcommands
Subcommand --> "1" CommonOptionsParser : parser
CLI ..> SubcommandsOptionParser : construct / parse
CLI ..> Subcommand : call func(lib, opts, args)

' beets/ui/__init__.py: _setup() combines default_commands and plugins.commands().
' beets/ui/commands/__init__.py: default_commands contains Subcommand instances.
CLI ..> Commands : register commands
CLI ..> Plugins : load / collect commands\nsend CLI events

' beets/ui/commands/{list,modify,config}.py: representative handler responsibilities.
Commands ..> Library : query / modify

' beets/ui/commands/import_/__init__.py: import_cmd.func = import_func;
' import_func calls import_files, which constructs TerminalImportSession and runs it.
Commands ..> ImportFiles : import_func() calls
ImportFiles ..> TerminalSession : create / run
' beets/ui/commands/import_/session.py: actual ImportSession subclass.
TerminalSession --|> ImportSession
' beets/importer/session.py: __init__ stores the supplied Library as self.lib.
ImportSession --> "1" Library : lib

' beets/ui/__init__.py: _bootstrap_config calls read/set_file/set_args on beets.config.
' _open_library creates Library using the configured database and music directory.
CLI ..> Config : bootstrap configuration
CLI ..> Library : _open_library()
' beets/ui/__init__.py: _bootstrap_logging configures the logger; path display uses util.
CLI ..> Logging : configure / report errors
' beets/ui/commands/import_/__init__.py: normalize paths and convert to OS paths.
ImportFiles ..> Util : path helpers

note bottom of Config
  Shared instance: beets.config
  Base class: confuse.LazyConfig
end note

legend bottom
  Plain boxes: classes; <<reference>>: classes detailed elsewhere.
  <<module>>: module with selected names; <<function>>: function.
  Hollow triangles: inheritance; solid arrows: stored references.
  Dashed arrows: calls or uses; command handlers live in submodules.
endlegend
@enduml
